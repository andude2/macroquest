/* MacroQuest RmlUi design tokens. Theme sheets override these inherited values. */
body {
  --mq-color-window: #1a2330e8;
  --mq-color-window-border: #5b7a9e;
  --mq-color-titlebar: #24384e;
  --mq-color-surface: #151b29f2;
  --mq-color-surface-raised: #181f2f;
  --mq-color-surface-control: #1b2333;
  --mq-color-surface-hover: #27334a;
  --mq-color-surface-pressed: #182031;
  --mq-color-surface-input: #0e131e;
  --mq-color-surface-track: #282e3a;
  --mq-color-surface-badge: #272d3a;
  --mq-color-surface-tooltip: #080b12f5;
  --mq-color-surface-divider: #283146;
  --mq-color-border: #29334a;
  --mq-color-border-control: #303b52;
  --mq-color-border-hover: #465b7b;
  --mq-color-border-tooltip: #3a465e;
  --mq-color-text: #dce5f5;
  --mq-color-text-strong: #f4f7ff;
  --mq-color-text-muted: #8997aa;
  --mq-color-accent: #3979df;
  --mq-color-accent-hover: #4788ef;
  --mq-color-accent-border: #5792ed;
  --mq-color-accent-soft: #17314a;
  --mq-color-focus: #a9d1ff;
  --mq-color-text-icon: #72b7ff;
  --mq-color-on-accent: #ffffff;
  --mq-color-success: #9cf0bd;
  --mq-color-success-surface: #173b2b;
  --mq-color-warning: #ffd979;
  --mq-color-warning-surface: #453719;
  --mq-color-danger: #ffaaaa;
  --mq-color-danger-surface: #48232b;
  --mq-color-progress: #51d6ad;
  --mq-font-size-base: 17px;
  --mq-font-size-title: 24px;
  --mq-font-size-large: 20px;
  --mq-font-size-small: 11px;
  --mq-space-1: 3px;
  --mq-space-2: 6px;
  --mq-space-3: 10px;
  --mq-space-4: 18px;
  --mq-space-5: 24px;
  --mq-card-padding: 10px;
  --mq-window-padding: 18px;
  --mq-window-padding-negative: -18px;
  --mq-titlebar-padding-y: 10px;
  --mq-control-height: 30px;
  --mq-button-padding-x: 10px;
  --mq-button-padding-y: 5px;
  --mq-table-row-height: 31px;
  --mq-stat-min-width: 128px;
  --mq-icon-size: 34px;
  --mq-icon-inset: 9px;
  --mq-switch-width: 30px;
  --mq-switch-height: 16px;
  --mq-switch-thumb-size: 12px;
  --mq-switch-thumb-offset: 2px;
  --mq-switch-thumb-checked-left: 16px;
  --mq-divider-height: 1px;
  --mq-resize-icon-line-height: 22px;
  --mq-resize-footer-height: 26px;
  --mq-resize-handle-size: 24px;
  --mq-border-width: 1px;
  --mq-radius-sm: 6px;
  --mq-radius-md: 8px;
  --mq-radius-lg: 9px;
  --mq-disabled-opacity: 0.45;
  --mq-transition-fast: 0.12s;
  --mq-tooltip-z: 20;
}
