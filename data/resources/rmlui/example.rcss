body {
  position: absolute;
  left: 430px;
  top: 32px;
  width: 390px;
  padding: 18px;
  font-family: "Segoe UI";
  font-size: 16px;
  color: #edf7ee;
  background-color: #14231be8;
  border: 1px #58a878;
}

h1 {
  margin: 0 0 8px 0;
  font-size: 22px;
  color: #91e6ad;
}

p { margin: 4px 0 12px 0; }

input {
  display: block;
  width: 330px;
  padding: 6px;
  color: #edf7ee;
  background-color: #21382a;
  border: 1px #65b680;
}

input:focus {
  background-color: #2b4937;
  border-color: #a5efbd;
}
